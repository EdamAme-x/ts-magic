{
	"name": "ts-magic",
	"version": "0.0.0",
	"description": "Magic of TypeScript",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": ["dist"],
	"scripts": {
		"build": "bun run build:esm && bun run build:cjs && bun run build:types",
		"build:esm": "bun build ./src/index.ts --outfile ./dist/index.js --format esm --target node",
		"build:cjs": "bun build ./src/index.ts --outfile ./dist/index.cjs --format cjs --target node",
		"build:types": "tsc --emitDeclarationOnly && cp dist/index.d.ts dist/index.d.cts",
		"test": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "bun run build"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/EdamAme-x/ts-magic.git"
	},
	"keywords": ["typescript", "magic", "utility"],
	"author": "EdamAme-x",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/EdamAme-x/ts-magic/issues"
	},
	"homepage": "https://github.com/EdamAme-x/ts-magic#readme",
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"lefthook": "^1.11.0",
		"typescript": "^5.8.0"
	},
	"trustedDependencies": ["@biomejs/biome"]
}
